---
/** シェブロン。パンくず・ページネーション・FAQ の開閉に使う（lucide 系 stroke）。 */
interface Props {
  width?: number
  height?: number
  strokeWidth?: number
  class?: string
}
const { width = 8, height = 12, strokeWidth = 1.5, class: className } = Astro.props
---

<svg
  width={width}
  height={height}
  viewBox="0 0 8 12"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path d="M1.5 1l5 5-5 5" stroke="currentColor" stroke-width={strokeWidth} />
</svg>
