---
import { altText, srcSet, imageUrl } from '../lib/image'
import { formatDate } from '../lib/format'
import type { PostCard } from '../lib/types'

/**
 * 新着記事カード（16:10）と PICKUP（16:9）、トップの新着リスト行（row）の共用。
 * ラベルは「REVIEW / MERRELL」= ハブの英字ラベル + 先頭トピック。
 * pickup / row はカテゴリと日付を1行に並べる（plan-c3）。
 */
interface Props {
  post: PostCard
  variant?: 'card' | 'pickup' | 'row'
  loading?: 'lazy' | 'eager'
}
const { post, variant = 'card', loading = 'lazy' } = Astro.props

const isPickup = variant === 'pickup'
const isRow = variant === 'row'
const aspect = isPickup ? 16 / 9 : 16 / 10
const widths = isPickup ? [600, 900, 1200] : isRow ? [300, 460, 640] : [420, 640, 840]
const sizes = isPickup
  ? '(max-width: 960px) 100vw, 540px'
  : isRow
    ? '(max-width: 960px) 120px, 220px'
    : '(max-width: 960px) 100vw, 380px'
const topic = post.topics?.[0]
const labelParts = [post.category?.labelEn, topic?.labelShort || topic?.title].filter(Boolean)
const className = isPickup ? 'pk' : isRow ? 'row' : 'card'
const photoClass = isPickup ? 'pk-photo' : isRow ? 'row-photo' : 'card-photo'
---

<a href={`/articles/${post.slug}/`} class={className}>
  <div class={photoClass}>
    {
      post.mainImage && (
        <img
          class="fill"
          src={imageUrl(post.mainImage, widths[1], Math.round(widths[1] / aspect))}
          srcset={srcSet(post.mainImage, widths, aspect)}
          sizes={sizes}
          width={widths[1]}
          height={Math.round(widths[1] / aspect)}
          alt={altText(post.mainImage, `記事カード: ${post.title}`)}
          loading={loading}
          decoding="async"
        />
      )
    }
  </div>
  {
    isPickup || isRow ? (
      <div>
        <div class="meta-line">
          {labelParts.length > 0 && <span class="cat">{labelParts.join(' / ')}</span>}
          <time class="date" datetime={post.publishedAt}>
            {formatDate(post.publishedAt)}
          </time>
        </div>
        <h3>{post.title}</h3>
      </div>
    ) : (
      <Fragment>
        {labelParts.length > 0 && <span class="cat">{labelParts.join(' / ')}</span>}
        <h3>{post.title}</h3>
        <p class="meta">
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        </p>
      </Fragment>
    )
  }
</a>
