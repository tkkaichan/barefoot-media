---
import ArticleCard from '../components/ArticleCard.astro'
import Arrow from '../components/Arrow.astro'
import Marquee from '../components/Marquee.astro'
import NewsletterBand from '../components/NewsletterBand.astro'
import SectionHead from '../components/SectionHead.astro'
import Sidebar from '../components/Sidebar.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { altText, imageUrl } from '../lib/image'
import { itemListLd } from '../lib/jsonld'
import { pad2 } from '../lib/format'
import { HOME_LATEST_COUNT } from '../lib/config'
import {
  getAllPosts,
  getFallbackPickup,
  getHomepage,
  getNav,
  getSeriesList,
  getSiteSettings,
} from '../lib/queries'

const [site, nav, homepage, allPosts, seriesList] = await Promise.all([
  getSiteSettings(),
  getNav(),
  getHomepage(),
  getAllPosts(),
  getSeriesList(),
])

const pickup =
  homepage?.pickupPosts && homepage.pickupPosts.length > 0
    ? homepage.pickupPosts
    : await getFallbackPickup()

const pickupIds = new Set(pickup.map((p) => p._id))
const latest = allPosts.filter((p) => !pickupIds.has(p._id)).slice(0, HOME_LATEST_COUNT)

/** 見出しは2行目以降を1.5em字下げする（plan-c3）。改行位置は Sanity の入力どおり。 */
const headlineHtml = (homepage?.heroHeadline ?? '')
  .split('\n')
  .map((line, i) => (i === 0 ? line : `<span class="indent">${line}</span>`))
  .join('<br>')

const jsonLd = [
  itemListLd(
    site,
    latest.map((p) => ({ name: p.title, path: `/articles/${p.slug}/` })),
  ),
]
---

<BaseLayout site={site} nav={nav} title={site.siteName} jsonLd={jsonLd}>
  {
    homepage && (
      <div class="hero">
        <p class="hero-side">{homepage.heroSideLabel ?? 'KUMAMOTO — YAMAGA — FIELD TESTED'}</p>
        <div class="container">
          {homepage.heroEyebrow && <p class="eyebrow">{homepage.heroEyebrow}</p>}
          <h1 set:html={headlineHtml} />
          <div class="hero-foot">
            <p class="hero-lead">{homepage.heroLead}</p>
            <a href={homepage.heroCtaHref} class="btn-primary">
              {homepage.heroCtaLabel}
              <Arrow width={26} />
            </a>
          </div>
        </div>
      </div>
    )
  }

  <Marquee images={homepage?.marqueeImages ?? []} />

  {
    pickup.length > 0 && (
      <div class="pickup">
        <div class="container sec">
          <SectionHead en="PICKUP" title="編集部おすすめ" ghost />
          <div class="pickup-grid">
            {pickup.map((post, i) => (
              <ArticleCard post={post} variant="pickup" loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="container body-grid">
    <div class="sec">
      <SectionHead en="LATEST" title="新着記事" ghost />
      {
        latest.length > 0 ? (
          <div>
            {latest.map((post, i) => (
              <ArticleCard post={post} variant="row" loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
          </div>
        ) : (
          <p class="cards-empty">記事はまだありません。</p>
        )
      }
      <a href="/articles/" class="link-arrow list-more">
        記事一覧をすべて見る
        <Arrow width={26} />
      </a>
    </div>

    <Sidebar site={site} nav={nav} homepage={homepage} />
  </div>

  {
    seriesList.length > 0 && (
      <div class="series">
        <div class="container">
          <SectionHead en="SERIES" title="連載" />
          <div class="series-grid">
            {seriesList.map((s) => (
              <a href={`/series/${s.slug}/`} class="sr">
                <div>
                  <span class="sr-num">SERIES {pad2(s.number)}</span>
                  <h3>{s.title}</h3>
                  {s.description && <p>{s.description}</p>}
                </div>
                <div class="sr-photo">
                  {s.image && (
                    <img
                      src={imageUrl(s.image as any, 220, 220)}
                      width="110"
                      height="110"
                      alt={altText(s.image as any, `連載「${s.title}」`)}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <NewsletterBand slot="after-main" site={site} source="home-band" />
</BaseLayout>
