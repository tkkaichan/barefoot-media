---
import ArticleCard from '../components/ArticleCard.astro'
import Arrow from '../components/Arrow.astro'
import NewsletterBand from '../components/NewsletterBand.astro'
import Pagination from '../components/Pagination.astro'
import SectionHead from '../components/SectionHead.astro'
import Sidebar from '../components/Sidebar.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { altText, imageUrl, srcSet } from '../lib/image'
import { itemListLd } from '../lib/jsonld'
import { pad2 } from '../lib/format'
import { HOME_LATEST_COUNT, PAGE_SIZE } from '../lib/config'
import {
  getAllPosts,
  getFallbackPickup,
  getHomepage,
  getNav,
  getSeriesList,
  getSiteSettings,
} from '../lib/queries'

const [site, nav, homepage, allPosts, seriesList] = await Promise.all([
  getSiteSettings(),
  getNav(),
  getHomepage(),
  getAllPosts(),
  getSeriesList(),
])

const pickup =
  homepage?.pickupPosts && homepage.pickupPosts.length > 0
    ? homepage.pickupPosts
    : await getFallbackPickup()

const pickupIds = new Set(pickup.map((p) => p._id))
const latest = allPosts.filter((p) => !pickupIds.has(p._id)).slice(0, HOME_LATEST_COUNT)
const totalListPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE))

const jsonLd = [
  itemListLd(
    site,
    latest.map((p) => ({ name: p.title, path: `/articles/${p.slug}/` })),
  ),
]
---

<BaseLayout site={site} nav={nav} title={site.siteName} jsonLd={jsonLd}>
  {
    homepage && (
      <div class="hero">
        <div class="container hero-grid">
          <div>
            {homepage.heroEyebrow && <p class="eyebrow">{homepage.heroEyebrow}</p>}
            <h1 set:html={homepage.heroHeadline.replace(/\n/g, '<br>')} />
            <p class="hero-lead">{homepage.heroLead}</p>
            <div class="hero-actions">
              <a href={homepage.heroCtaHref} class="btn-primary">
                {homepage.heroCtaLabel}
                <Arrow width={26} />
              </a>
            </div>
          </div>
          <div class="hero-photo">
            {homepage.heroImage && (
              <img
                src={imageUrl(homepage.heroImage, 800, 600)}
                srcset={srcSet(homepage.heroImage, [600, 800, 1200], 4 / 3)}
                sizes="(max-width: 960px) 100vw, 440px"
                width="800"
                height="600"
                alt={altText(homepage.heroImage, 'トップページのヒーロー写真')}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}
          </div>
        </div>
      </div>
    )
  }

  {
    pickup.length > 0 && (
      <div class="pickup">
        <div class="container">
          <SectionHead en="PICKUP" title="編集部おすすめ" />
          <div class="pickup-grid">
            {pickup.map((post, i) => (
              <ArticleCard post={post} variant="pickup" loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="container body-grid">
    <div>
      <SectionHead en="LATEST" title="新着記事" moreHref="/articles/" />
      {
        latest.length > 0 ? (
          <div class="cards">
            {latest.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        ) : (
          <p class="cards-empty">記事はまだありません。</p>
        )
      }
      <Pagination current={1} total={totalListPages} basePath="/articles/" />
    </div>

    <Sidebar site={site} nav={nav} homepage={homepage} />
  </div>

  {
    seriesList.length > 0 && (
      <div class="series">
        <div class="container">
          <SectionHead en="SERIES" title="連載" />
          <div class="series-grid">
            {seriesList.map((s) => (
              <a href={`/series/${s.slug}/`} class="sr">
                <div>
                  <span class="sr-num">SERIES {pad2(s.number)}</span>
                  <h3>{s.title}</h3>
                  {s.description && <p>{s.description}</p>}
                </div>
                <div class="sr-photo">
                  {s.image && (
                    <img
                      src={imageUrl(s.image as any, 220, 220)}
                      width="110"
                      height="110"
                      alt={altText(s.image as any, `連載「${s.title}」`)}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <NewsletterBand slot="after-main" site={site} source="home-band" />
</BaseLayout>
