---
import type { GetStaticPaths, Page } from 'astro'
import ArticleCard from '../../../components/ArticleCard.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import NewsletterBand from '../../../components/NewsletterBand.astro'
import Pagination from '../../../components/Pagination.astro'
import Sidebar from '../../../components/Sidebar.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { PAGE_SIZE } from '../../../lib/config'
import { breadcrumbLd, itemListLd } from '../../../lib/jsonld'
import {
  getAllCategories,
  getHomepage,
  getNav,
  getPostsByCategory,
  getSiteSettings,
} from '../../../lib/queries'
import type { CategoryRef, PostCard } from '../../../lib/types'

/** ハブ別の記事一覧。/category/<slug>/ と /category/<slug>/2/ …。 */
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // ナビに出さないハブも一覧ページは作る
  const categories = await getAllCategories()
  const paths = await Promise.all(
    categories.map(async (category) => {
      const posts = await getPostsByCategory(category.slug)
      return paginate(posts, {
        params: { slug: category.slug },
        props: { category },
        pageSize: PAGE_SIZE,
      })
    }),
  )
  return paths.flat()
}

interface Props {
  page: Page<PostCard>
  category: CategoryRef
}
const { page, category } = Astro.props

const [site, nav, homepage] = await Promise.all([getSiteSettings(), getNav(), getHomepage()])

const trail = [
  { name: 'ホーム', path: '/' },
  { name: category.title, path: `/category/${category.slug}/` },
]

const jsonLd = [
  breadcrumbLd(site, trail),
  itemListLd(
    site,
    page.data.map((p) => ({ name: p.title, path: `/articles/${p.slug}/` })),
  ),
]
---

<BaseLayout
  site={site}
  nav={nav}
  title={category.title}
  description={category.description || `${category.title}の記事一覧。${site.description}`}
  noindex={page.currentPage > 1}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <div class="page-head">
      <p class="page-en">{category.labelEn}</p>
      <h1>{category.title}</h1>
      {category.description && <p class="page-lead">{category.description}</p>}
    </div>

    <div class="body-grid">
      <div>
        {
          page.data.length > 0 ? (
            <div class="cards">
              {page.data.map((post) => (
                <ArticleCard post={post} />
              ))}
            </div>
          ) : (
            <p class="cards-empty">このカテゴリの記事はまだありません。</p>
          )
        }
        <Pagination
          current={page.currentPage}
          total={page.lastPage}
          basePath={`/category/${category.slug}/`}
        />
      </div>
      <Sidebar site={site} nav={nav} homepage={homepage} />
    </div>
  </div>

  <NewsletterBand slot="after-main" site={site} source="category-band" />
</BaseLayout>
