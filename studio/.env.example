# Sanity Studio 用の環境変数。このファイルをコピーして .env.local を作る。
# .env.local は git にコミットしないこと（.gitignore 済み）。
# ※ここに書くのは公開しても差し支えない値のみ。書き込みトークン等の秘匿値は
#   Studio 側ではなく Vercel / Sanity の管理画面の環境変数に登録すること。

SANITY_STUDIO_PROJECT_ID=xxxxxxxx
SANITY_STUDIO_DATASET=production

# sanity deploy 時のサブドメイン（https://<host>.sanity.studio）
SANITY_STUDIO_HOST=barefoot-media

# 「プレビュー」ボタンから開く Astro 側の URL
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
